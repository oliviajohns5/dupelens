{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DupeLens",
  "version": "0.1.0",
  "identifier": "io.dupelens.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../ui-dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "DupeLens",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
